#%RAML 1.0 DataType
properties:
  accountNum:
    required: true
    minLength: 10
    maxLength: 10
  atmPin:
    required: true
    type: string
    minLength: 4
    maxLength: 4
  ifscCode:
    required: true
    minLength: 4
    maxLength: 10
  depositAmount: # it is not a required field. 
    type: number
  mailId: # it is a mandotory field
    required: true
    type: string
  contactNumber:
    required: true
    type: integer